{
  "name": "prism-next",
  "productName": "PrismNext",
  "version": "0.7.0-beta.4",
  "description": "Local-first collaborative AI scientist — literature, experiments, and LaTeX in one desktop workspace",
  "license": "Apache-2.0",
  "author": "yibocat",
  "homepage": "https://github.com/yibocat/prismnext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yibocat/prismnext.git"
  },
  "bugs": {
    "url": "https://github.com/yibocat/prismnext/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "copy-pdfjs-assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "bash -c 'unset ELECTRON_RUN_AS_NODE && node scripts/copy-pdfjs-assets.mjs && node scripts/ensure-native-modules.mjs && exec electron-vite dev'",
    "dev:pro": "bash -c 'unset ELECTRON_RUN_AS_NODE && node scripts/copy-pdfjs-assets.mjs && node scripts/ensure-native-modules.mjs && export PRISM_PRO_PATH=\"$PWD/../prism-next-pro/src/index.ts\" && exec electron-vite dev'",
    "build": "node scripts/copy-pdfjs-assets.mjs && node scripts/prepare-pro-packs.mjs && electron-vite build",
    "preview": "node scripts/ensure-native-modules.mjs && electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci-gate": "bash scripts/release/verify-before-push.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "rebuild:native": "pnpm exec electron-rebuild -f -w node-pty",
    "postinstall": "pnpm exec electron-rebuild -f -w node-pty",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "dist:dir": "pnpm build && electron-builder --dir --publish never",
    "dist:pro:dir": "bash -c 'export PRISM_PRO_PATH=\"$PWD/../prism-next-pro/src/index.ts\" && pnpm dist:dir'"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.22.1",
    "@anaralabs/lector": "^3.12.5",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@citation-js/plugin-doi": "^0.7.21",
    "@citation-js/plugin-ris": "^0.7.21",
    "@codemirror/autocomplete": "^6.20.3",
